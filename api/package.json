{
  "name": "car-finance-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "auth:generate": "npx auth@latest generate --config ./src/auth.ts --output ./src/db/schema/auth.ts --yes",
    "db:up": "docker compose -f docker-compose.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.yml down",
    "db:logs": "docker compose -f docker-compose.yml logs -f postgres",
    "db:generate": "npm run build && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "better-auth": "^1.3.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^24.6.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
